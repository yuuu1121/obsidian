# Normalize line endings so CRLF/LF differences never show up as changes.
# Text files: stored as LF in the repo, checked out per core.autocrlf on Windows.
* text=auto

# Markdown / notes / code / data are text — force consistent handling.
*.md   text
*.txt  text
*.csv  text
*.py   text
*.css  text
*.html text
*.json text

# Binary assets: never touch line endings (Git would corrupt them otherwise).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  binary
*.pdf  binary
*.mdb  binary
*.mdc  binary
*.excalidraw binary
